{
  "name": "stemmer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "packageManager": "bun@1.3.9",
  "engines": {
    "bun": ">=1.3.9"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun run dev:electron",
    "dev:renderer": "vite dev --host 127.0.0.1 --port 3000 --strictPort",
    "dev:electron": "bun run scripts/dev-electron.ts",
    "build": "bun run build:renderer && bun run build:electron && bun run build:worker",
    "build:ci": "bun run build:renderer && bun run build:electron",
    "build:renderer": "vite build",
    "build:electron": "bun build --target=node --format=cjs --external electron --outfile dist-electron/main.cjs ./electron/main.ts && bun build --target=node --format=cjs --external electron --outfile dist-electron/preload.cjs ./electron/preload.ts && cp electron/loading.html dist-electron/loading.html",
    "build:worker": "bun run scripts/build-worker-binary.ts",
    "prepare:desktop-assets": "bun run scripts/prepare-desktop-assets.ts",
    "preview:renderer": "vite preview --host 127.0.0.1 --port 3000",
    "electron": "bun run build:electron && bun x electron .",
    "dist": "bun run prepare:desktop-assets && bun run build && bun x electron-builder",
    "setup:runtime": "bun run scripts/setup-runtime.ts",
    "runtime:doctor": "bun run scripts/runtime-doctor.ts",
    "test": "vitest run",
    "check": "ultracite check",
    "lint": "bun run check",
    "typecheck": "bunx tsc --noEmit",
    "ci": "bun run lint && bun run typecheck && bun run test && bun run build:ci",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jotai": "^2.19.0",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tone": "^15.1.22",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^37.5.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^28.1.0",
    "react-scan": "^0.5.3",
    "typescript": "^5.7.2",
    "ultracite": "7.4.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "build": {
    "appId": "dev.bomarov.stemmer",
    "productName": "Stemmer",
    "directories": {
      "output": "release-output"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "worker-dist/stemmer-worker",
        "to": "worker"
      },
      {
        "from": "app-assets/bin",
        "to": "bin"
      }
    ],
    "icon": "build/icon.png",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.music",
      "identity": null,
      "target": [
        {
          "target": "dmg"
        }
      ],
      "signIgnore": [
        "Python\\.framework($|/)"
      ]
    },
    "dmg": {
      "writeUpdateInfo": false
    }
  }
}
